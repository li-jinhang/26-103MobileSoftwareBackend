generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id
  name                     String
  account                  String               @unique
  passwordHash             String
  department               String
  role                     String
  roleLabel                String
  permissionsJson          String
  favoriteKnowledgeIdsJson String
  recentKnowledgeIdsJson   String
  todoCount                Int                  @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  sessions                 Session[]
  workflowInstances        WorkflowInstance[]
  knowledgeCorrections     KnowledgeCorrection[]
  assistantHistories       AssistantHistory[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeCategory {
  id          String             @id
  name        String
  description String
  sortOrder   Int                @default(0)
  articles    KnowledgeArticle[]
}

model KnowledgeArticle {
  id                     String                @id
  title                  String
  summary                String
  content                String
  categoryId             String
  categoryName           String
  tagsJson               String
  updateTime             String
  version                String
  status                 String
  attachmentsJson        String
  relatedWorkflowIdsJson String
  category               KnowledgeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  corrections            KnowledgeCorrection[]
}

model WorkflowTemplate {
  id                       String @id
  name                     String
  description              String
  approverText             String
  relatedKnowledgeIdsJson  String
  riskLevel                String
  riskHint                 String
  defaultApproverRolesJson String
}

model WorkflowInstance {
  id                     String           @id
  templateId             String
  title                  String
  applicantId            String
  applicantName          String
  status                 String
  currentNode            String
  currentApproverRole    String
  createTime             String
  latestComment          String
  relatedKnowledgeIdsJson String
  amount                 Float
  formSummary            String
  formDetailJson         String
  riskLevel              String
  riskReason             String
  requiresSecurityConfirm Boolean
  securityConfirmed      Boolean          @default(false)
  applicant              User             @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  approvalRecords        ApprovalRecord[]

  @@index([applicantId])
  @@index([currentApproverRole])
}

model ApprovalRecord {
  id           String           @id
  instanceId   String
  nodeName     String
  operatorRole String
  operatorName String
  decision     String
  comment      String
  time         String
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

model Notification {
  id              String @id
  title           String
  content         String
  time            String
  read            Boolean @default(false)
  targetRolesJson String
  targetType      String
  targetId        String
}

model KnowledgeCorrection {
  id         String           @id
  articleId  String
  userId     String
  content    String
  createTime String
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AssistantHistory {
  id                   String @id
  userId               String
  question             String
  answer               String
  relatedKnowledgeIdsJson String
  recommendedWorkflowId String
  time                 String
  user                 User   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id           String @id
  module       String
  action       String
  operatorName String
  operatorRole String
  riskLevel    String
  detail       String
  time         String
}
